VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only automated setup variables. Add these in Vercel; never prefix them with VITE_.
SETUP_BASE_URL=http://localhost:5173
SETUP_SUPABASE_URL=https://YOUR_PROVISIONING_PROJECT.supabase.co
SETUP_SUPABASE_SERVICE_ROLE_KEY=your-provisioning-service-role-key
PROVISIONING_ENCRYPTION_KEY=32-byte-base64url-key
GITHUB_APP_CLIENT_ID=your-github-app-client-id
GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret
GITHUB_TEMPLATE_OWNER=your-github-username
GITHUB_TEMPLATE_REPO=spending-tracker
SUPABASE_OAUTH_CLIENT_ID=your-supabase-oauth-client-id
SUPABASE_OAUTH_CLIENT_SECRET=your-supabase-oauth-client-secret
VERCEL_INTEGRATION_SLUG=your-vercel-integration-slug
VERCEL_INTEGRATION_CLIENT_ID=your-vercel-integration-client-id
VERCEL_INTEGRATION_CLIENT_SECRET=your-vercel-integration-client-secret
